---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Generales/Button.astro";
---

<Layout title="Moka - 404">
  <section class="main-404">
    <h1>No hemos podido encontrar esa página</h1>
    <Button
      title="Volver al inicio"
      href="/"
    />
  </section>
</Layout>

<style>
  .main-404 {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    justify-content: center;
    align-items: center;
    height: 100vh;
    width: 100%;
  }

  h1 {
    color: var(--Darkerblue);
  }
</style>
