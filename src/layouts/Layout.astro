---
import ViewTransitions from "astro/components/ViewTransitions.astro";
import Footer from "../components/Generales/Footer.astro";
import Nav from "../components/Generales/Nav.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Astro description"
    />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <!--  <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
    /> -->
    <title>{title}</title>
  </head>
  <body>
    <ViewTransitions />
    <Nav />
    <main class="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr auto;
  }
</style>
