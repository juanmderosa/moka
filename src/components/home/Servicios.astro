---
import { services } from "../../assets/data/servicios";
---

<section class="main-container">
  <h2 class="services-title">Servicios</h2>
  <div class="services-container">
    {
      services.map((service) => (
        <article class="service-container">
          <h3>{service.title}</h3>
          <p class="service-description">{service.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .main-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    width: 100%;
    padding: 3%;
    background-color: var(--Darkerblue);
    gap: 2rem;
  }
  .services-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    align-content: center;
    padding: 3%;
  }

  .service-container {
    display: flex;
    gap: 1rem;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: var(--White);
    border-radius: 50px;
    background: #3a4bba;
    box-shadow:
      20px 20px 60px #31409e,
      -20px -20px 60px #4356d6;
    padding: 2rem;
    text-align: center;
  }
  .service-container > h3 {
    font-family: "Raleway", sans-serif;
    font-size: 1.5rem;
  }

  .services-title {
    color: var(--White);
  }

  .service-description {
    color: var(--White);
  }

  @media (max-width: 900px) {
    .main-container {
      padding-block: 10%;
    }

    .services-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 550px) {
    .services-container {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  @media screen and (min-width: 800px) and (max-aspect-ratio: 1/1) {
    .main-container {
      min-height: auto;
    }
  }
</style>
