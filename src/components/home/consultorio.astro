---
import Button from "../Generales/Button.astro";
import consultorioImage from "../../assets/images/consultorios.png";
import { Image } from "astro:assets";
---

<section class="main-container">
  <article class="image-container">
    <Image
      src={consultorioImage}
      alt="consultorios"
      class="section-image clip-container"
    />
  </article>
  <article class="text-container">
    <h2>Consultorios</h2>
    <p>
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Tempora, ratione.
      Temporibus odit repellendus in ratione repudiandae praesentium. Neque,
      distinctio dicta facilis corrupti dolorum reiciendis iste beatae eaque
      possimus iure expedita! Corrupti, quisquam ex fugiat illo nostrum quos sit
      aperiam quo inventore. Sit, doloremque. Molestiae, eum. Similique eveniet
      pariatur molestiae corrupti optio est. At, ullam? Dignissimos temporibus
      odio itaque quae exercitationem!
    </p>
    <ul class="characteristics">
      <li class="characteristic-li">Característica 1 - Poner un descripción</li>
      <li class="characteristic-li">Característica 2 - Poner un descripción</li>
      <li class="characteristic-li">Característica 3 - Poner un descripción</li>
      <li class="characteristic-li">Característica 4 - Poner un descripción</li>
      <li class="characteristic-li">Característica 5 - Poner un descripción</li>
      <li class="characteristic-li">Característica 6 - Poner un descripción</li>
    </ul>
    <Button
      title="Conocer los consultorios"
      href="/consultorios"
    />
  </article>
</section>

<style>
  .main-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
    width: 100%;
    gap: 2rem;
  }
  .text-container {
    grid-column: 2/3;
    grid-row: 1/2;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 2rem;
    padding-inline: 5rem;
    line-height: 1.5rem;
  }

  .image-container {
    grid-column: 1/2;
    grid-row: 1/2;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .section-image {
    width: 100%;
    object-fit: cover;
    object-position: left;
    max-height: 100vh;
  }
  .clip-container {
    clip-path: polygon(0 0, 80% 0%, 100% 100%, 0% 100%);
  }

  @media screen and (max-width: 1024px) {
    .image-container {
      padding: 2rem;
      border-radius: 12px;
    }
    .clip-container {
      clip-path: none;
      border-radius: 12px;
      box-shadow: 0px 0px 15px 1px var(--Gray);
    }

    .text-container {
      gap: 2rem;
      padding: 2rem;
      line-height: 1.5rem;
      text-align: center;
    }
  }

  @media screen and (max-width: 768px) {
    .main-container {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .image-container {
      width: 100%;
    }
    .clip-container {
      max-height: 50vh;
    }

    .text-container {
      width: 100%;
    }
  }

  @media screen and (min-width: 800px) and (max-aspect-ratio: 1/1) {
    .main-container {
      min-height: auto;
    }
  }
</style>
