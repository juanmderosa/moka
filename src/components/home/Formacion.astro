---
import Button from "../Generales/Button.astro";
import { Image } from "astro:assets";
import imagePrueba from "../../assets/images/inicio1.jpg";
---

<section class="main-container">
  <article class="text-container">
    <h2>Formación Profesional</h2>
    <p>
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Tempora, ratione.
      Temporibus odit repellendus in ratione repudiandae praesentium. Neque,
      distinctio dicta facilis corrupti dolorum reiciendis iste beatae eaque
      possimus iure expedita! Corrupti, quisquam ex fugiat illo nostrum quos sit
      aperiam quo inventore. Sit, doloremque.
    </p>
    <Button
      title="Ver cursos"
      href="/formacion"
    />
  </article>
  <article class="image-container">
    <Image
      src={imagePrueba}
      alt="Formacion"
      class="section-image"
      loading={"eager"}
    />
  </article>
</section>

<style>
  .main-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  p {
    color: var(--White);
    text-align: center;
  }
  h2 {
    color: var(--White);
    text-align: center;
  }

  .text-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    width: 50%;
    background: rgba(0, 7, 14, 0.7);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 10px;
    border: 1px solid var(--Lightblue);
    padding: 2rem;
    position: relative;
    z-index: 1;
  }

  .image-container {
    width: 100%;
    height: 100%;
    position: absolute;
    z-index: -1;
  }

  .section-image {
    width: 100%;
    object-fit: cover;
    height: 100%;
  }

  @media screen and (max-width: 900px) {
    .text-container {
      width: 80%;
    }
  }

  @media screen and (max-width: 550px) {
    .main-container {
      padding-block: 10%;
      min-height: 50vh;
    }
  }

  @media screen and (min-width: 800px) and (max-aspect-ratio: 1/1) {
    .main-container {
      min-height: auto;
    }
  }
</style>
