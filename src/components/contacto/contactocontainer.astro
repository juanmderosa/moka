---
import { Form } from "./Form";
import { Image } from "astro:assets";
import instagramIcon from "../../assets/icons/instagram3.svg";
import phoneIcon from "../../assets/icons/phone.svg";
import mailIcon from "../../assets/icons/mail.svg";
import locationIcon2 from "../../assets/icons/location2.svg";
---

<section class="main-container">
  <Form client:only="react" />
  <article class="datos-contacto-container">
    <aside class="map-container">
      <h2 class="contactanos-section-titles">Ubicación</h2>
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3284.1735432963696!2d-58.386626199999995!3d-34.59977289999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bccac773f7534b%3A0x5fe56ccc63984503!2sUruguay%20775%2C%20C1015%20Cdad.%20Aut%C3%B3noma%20de%20Buenos%20Aires!5e0!3m2!1ses!2sar!4v1718801808202!5m2!1ses!2sar"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="eager"
        referrerpolicy="no-referrer-when-downgrade"
        title="mapa de contacto"
      ></iframe>
    </aside>
    <aside class="contactanos-container">
      <h2>Contactanos</h2>
      <ul>
        <li>
          <span class="icon-container">
            <Image
              src={locationIcon2}
              alt="location icon"
              class="icon-contacto"
              loading="eager"
            />
          </span>
          <p>Uruguay 1234 - Piso 2</p>
        </li>
        <li>
          <span class="icon-container">
            <Image
              src={phoneIcon}
              alt="phone icon"
              class="icon-contacto"
              loading="lazy"
            />
          </span>
          <p>1234-5678</p>
        </li>
        <li>
          <span class="icon-container">
            <Image
              src={mailIcon}
              alt="mail icon"
              class="icon-contacto"
              loading="lazy"
            />
          </span>
          <p>info@moka.com</p>
        </li>
        <li>
          <a
            href="https://www.instagram.com"
            target="_blank">
            <span class="icon-container">
              <Image
                src={instagramIcon}
                alt="instagram icon"
                class="icon-contacto"
                loading="lazy"
              />
            </span>
            Seguinos en Instagram
          </a>
        </li>
      </ul>
    </aside>
  </article>

  <style>
    .main-container {
      padding: 3%;
      background-image: url(../../assets/images/contacto.png);
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover;
      display: flex;
      justify-content: space-between;
      align-items: stretch;
      gap: 2rem;
    }

    .datos-contacto-container {
      width: 50%;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      background-color: var(--White);
      border-radius: 1rem;
      padding: 1rem;
    }

    .map-container {
      width: 100%;
      height: 50%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 3%;
      border-radius: 12px;
    }

    .map-container > iframe {
      border-radius: 12px;
    }

    .contactanos-section-titles {
      margin-bottom: 1rem;
      text-align: center;
    }

    .contactanos-container {
      width: 100%;
      height: 50%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 3%;
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1rem;
    }

    li,
    li > a {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 1rem;
      font-size: 1rem;
    }

    .icon-container {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 40px;
      height: 40px;
      padding: 0.5rem;
      background-color: var(--Mediumblue);
      border-radius: 50%;
      box-shadow: 0px 0px 15px 1px var(--Gray);
      transition: all 0.5s ease-in-out;
    }
    .icon-contacto {
      width: 100%;
      height: 100%;
      object-fit: contain;
      border: none;
    }

    p,
    a {
      text-decoration: none;
      color: var(--Black);
    }

    @media screen and (max-width: 768px) {
      .main-container {
        flex-direction: column;
      }

      .datos-contacto-container {
        width: 100%;
      }
      .icon-container {
        width: 35px;
        height: 35px;
      }
    }
  </style>
</section>
