<style>
  /* MAIN */
  .main-container {
    display: flex;
    flex-direction: row-reverse;
    justify-content: center;
    align-items: center;
    height: 100vh;
    width: 100%;
    background-color: var(--Darkerblue);
  }
  /* RIGHT */
  .text-container {
    width: 50%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 2rem;
    padding-inline: 5rem;
    line-height: 1.5rem;
  }

  .text-container > h2,
  .text-container > p {
    color: var(--White);
  }

  /* LEFT */
  .image-container {
    width: 50%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }

  .clip-container {
    width: 100%;
    height: 100%;
    border-radius: 12px;
  }

  .section-image {
    width: 100%;
    object-fit: cover;
    height: 100%;
    border-radius: 12px;
    box-shadow: 0px 0px 15px 1px var(--Gray);
  }

  @media screen and (max-width: 1024px) {
    .main-container::before {
      display: none;
    }
    .main-container {
      height: auto;
      min-height: 50vh;
      flex-direction: column;
    }

    .image-container {
      width: 100%;
      object-fit: contain;
    }

    .text-container {
      width: 100%;
      height: 50%;
      margin-top: 0;
      padding: 2rem;
    }
  }

  @media screen and (min-width: 800px) and (max-aspect-ratio: 1/1) {
    .main-container {
      min-height: auto;
    }
  }
</style>
