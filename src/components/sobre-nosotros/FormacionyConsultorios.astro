---
import Button from "../Generales/Button.astro";
---

<section class="main-container">
  <article class="article-container">
    <h2>Conocé nuestros cursos</h2>
    <p>
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Tempora, ratione.
      Temporibus odit repellendus in ratione repudiandae praesentium.
    </p>
    <Button
      title="Ver cursos"
      href="/formacion"
    />
  </article>
  <article class="article-container">
    <h2>Conocé nuestros consultorios</h2>
    <p>
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Tempora, ratione.
      Temporibus odit repellendus in ratione repudiandae praesentium.
    </p>
    <Button
      title="Ver consultorios"
      href="/consultorios"
    />
  </article>
</section>

<style>
  .main-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-height: auto;
    width: 100%;
    padding: 5% 3%;
    gap: 2rem;
    background-image: url(../../assets/images/formacion.png);
    clip-path: polygon(0 13%, 100% 0, 100% 100%, 0% 100%);
    background-size: cover;
  }

  .article-container {
    display: flex;
    width: 50%;
    height: max-content;
    gap: 2rem;
    padding: 1rem 2rem;
    flex-direction: column;
    min-height: 300px;
    justify-content: flex-start;
    align-items: center;
    background: rgba(57, 116, 186, 0.5);
    background: rgba(0, 7, 14, 0.7);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border-radius: 10px;
    border: 1px solid var(--Lightblue);
  }

  .article-container h2 {
    color: var(--Lightblue);
    text-align: center;
  }

  .article-container p {
    color: var(--White);
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .main-container {
      flex-direction: column;
      clip-path: none;
    }
    .article-container {
      width: 100%;
      min-height: auto;
    }
  }

  @media screen and (min-width: 800px) and (max-aspect-ratio: 1/1) {
    .main-container {
      min-height: auto;
    }
  }
</style>
