---
import { Image } from "astro:assets";
import gabriel from "../../assets/images/images.jpg";
import gonzalo from "../../assets/images/medium-shot-doctor-wearing-coat.jpg";
import sofia from "../../assets/images/female-doctor-hospital-with-stethoscope.jpg";
import daniela from "../../assets/images/front-view-female-researcher-lab-coat.jpg";
import linkedinLogo from "../../assets/icons/linkedin.svg";

const doctors = [
  {
    img: gabriel,
    name: "Gabriel",
    lastname: "Mouriño",
    color: "#3974ba",
    linkedin: "https://www.linkedin.com/in/juanmderosa/",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam euismod aliquet quam ac pellentesque. Suspendisse urna urna, condimentum non ornare eget, condimentum posuere dui. Suspendisse pretium dictum leo quis blandit.",
  },
  {
    img: gonzalo,
    name: "Gonzalo",
    lastname: "Oviedo",
    color: "#5fa7dc",
    linkedin: "https://www.linkedin.com/in/juanmderosa/",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam euismod aliquet quam ac pellentesque. Suspendisse urna urna, condimentum non ornare eget, condimentum posuere dui. Suspendisse pretium dictum leo quis blandit.",
  },
  {
    img: sofia,
    name: "Sofía",
    lastname: "Kysilka",
    color: "#8ac1ea",
    linkedin: "https://www.linkedin.com/in/juanmderosa/",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam euismod aliquet quam ac pellentesque. Suspendisse urna urna, condimentum non ornare eget, condimentum posuere dui. Suspendisse pretium dictum leo quis blandit.",
  },
  {
    img: daniela,
    name: "Daniela",
    lastname: "Anastasio",
    color: "#a2c7ea",
    linkedin: "https://www.linkedin.com/in/juanmderosa/",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nam euismod aliquet quam ac pellentesque. Suspendisse urna urna, condimentum non ornare eget, condimentum posuere dui. Suspendisse pretium dictum leo quis blandit.",
  },
];
---

<section class="main-container">
  <h2>Equipo Médico</h2>
  <article class="doctors-container">
    {
      doctors.map((doctor) => (
        <>
          <div class="doctor-container">
            <div class="image-container">
              <Image
                src={doctor.img}
                class="doctor-img"
                width={100}
                height={100}
                alt={`${doctor.name} ${doctor.lastname}`}
                loading={"eager"}
              />
            </div>
            <p class="doctor-name">
              {doctor.name}
              <span class="doctor-lastname">{doctor.lastname}</span>
            </p>
            <div
              class="circle"
              style={`background-color: ${doctor.color}`}
            />

            <p class="doctor-description">{doctor.description}</p>
            <a
              class="logo-container"
              href={doctor.linkedin}
              target="_blank">
              <Image
                src={linkedinLogo}
                class="linkedin-logo"
                alt={"Linkedin"}
                width={30}
                height={30}
                loading={"eager"}
              />
            </a>
          </div>
        </>
      ))
    }
  </article>
</section>

<style>
  .main-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    width: 100%;
    position: relative;
    z-index: 1;
    padding: 3%;
  }

  h2 {
    margin-bottom: 5rem;
  }

  .doctors-container {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    justify-items: center;
    align-items: center;
    gap: 4rem;
    width: 100%;
  }
  .doctor-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }
  .image-container {
    width: 100px;
    height: 100px;
    border-radius: 100%;
  }
  .doctor-img {
    object-fit: cover;

    border-radius: 100%;
    box-shadow: 0px 0px 15px 1px var(--Gray);
  }

  .circle {
    width: 15px;
    height: 15px;
    border-radius: 50%;
  }

  .doctor-name {
    font-family: "ModernSans", sans-serif;
    color: var(--brandBlue2);
    display: flex;
    gap: 2px;
    justify-content: center;
    align-items: center;
  }
  .doctor-lastname {
    text-transform: uppercase;
    font-family: "MyriadPro", sans-serif;
    color: var(--brandBlue1);
  }

  .doctor-description {
    text-align: center;
  }

  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 50px;
    height: 50px;
    padding: 1rem;
    background-color: var(--Darkerblue);
    border-radius: 50%;
    box-shadow: 0px 0px 15px 1px var(--Gray);
    transition: all 0.5s ease-in-out;
  }
  .linkedin-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .logo-container:hover {
    padding: 0.7rem;
  }

  @media (max-width: 900px) {
    .main-container {
      padding-block: 10%;
      padding-inline: 2rem;
    }
    .doctors-container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 550px) {
    .doctors-container {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  @media screen and (min-width: 800px) and (max-aspect-ratio: 1/1) {
    .main-container {
      min-height: auto;
    }
  }
</style>
