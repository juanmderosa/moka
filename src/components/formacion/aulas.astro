---
import Formacion from "../../assets/images/formacion.png";
import { Image } from "astro:assets";
---

<section class="main-container">
  <h2>Aulas</h2>
  <div class="grid-container">
    <Image
      class="aula-foto-1"
      src={Formacion}
      alt="Formacion"
    />
    <Image
      class="aula-foto-2"
      src={Formacion}
      alt="Formacion"
    />
    <Image
      class="aula-foto-3"
      src={Formacion}
      alt="Formacion"
    />
    <Image
      class="aula-foto-4"
      src={Formacion}
      alt="Formacion"
    />
  </div>
</section>

<style>
  .main-container {
    background-color: var(--White);
    padding: 3%;
    z-index: -1;
    display: block;
    width: 100%;
    height: fit-content;
  }

  .main-container > h2 {
    text-align: center;
    margin-bottom: 2rem;
  }

  .grid-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-column-gap: 2rem;
    grid-row-gap: 2rem;
    width: 100%;
    height: 100%;
  }

  .aula-foto-1,
  .aula-foto-2,
  .aula-foto-3,
  .aula-foto-4 {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0px 0px 15px 1px var(--Gray);
    transition: all 0.5s ease-in-out;
  }

  @media screen and (max-width: 1024px) {
    .main-container {
      padding-block: 2rem;
    }
  }

  @media (max-width: 550px) {
    .grid-container {
      grid-template-columns: repeat(1, 1fr);
    }
  }

  @media screen and (min-width: 800px) and (max-aspect-ratio: 1/1) {
    .main-container {
      min-height: auto;
    }
  }
</style>
