---
import Button from "../Generales/Button.astro";
---

<section class="container">
  <h2>¿Necesitás más información sobre nuestros cursos?</h2>
  <Button
    href="/contacto"
    title="Contactanos"
  />
</section>

<style>
  .container {
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    width: 100%;
    padding: 5rem;
    background-color: var(--White);
    gap: 2rem;
    height: fit-content;
  }

  @media screen and (max-width: 768px) {
    .container {
      flex-direction: column;
      padding: 2rem;
      justify-content: center;
    }

    .container > h2 {
      text-align: center;
    }
  }

  @media screen and (min-width: 800px) and (max-aspect-ratio: 1/1) {
    .main-container {
      min-height: auto;
    }
  }
</style>
