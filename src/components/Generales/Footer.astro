---
import { Image } from "astro:assets";
import logoMoka from "../../assets/images/LogoMoka.webp";

const year = new Date().getFullYear();
---

<footer class="footer-container">
  <div class="brand-container">
    <Image
      src={logoMoka}
      alt="Moka Logo"
      width={150}
    />
  </div>
  <div class="footer-links-container">
    <ul class="ul-footer">
      <li><a href="/">Inicio</a></li>
      <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
      <li><a href="/consultorios">Consultorios</a></li>
      <li><a href="/formacion">Formación</a></li>
      <li><a href="/contacto">Contacto</a></li>
    </ul>
  </div>
  <div class="contact-container">
    <p><span>Dirección: </span>Uruguay 1234 - Piso 2</p>
    <p><span>Teléfono: </span>1234-5678</p>
    <p><span>E-mail: </span>info@moka.com</p>
  </div>
  <div class="copyright-container">
    <p>© {year} MOKA - Todos los derechos reservados.</p>
    <p>
      Desarrollado por <a
        href="https://juanmderosa-developer.com"
        target="_blank"
        >Juan Martín De Rosa</a
      >
    </p>
  </div>
</footer>

<style>
  footer {
    grid-row: 3/4;
    width: 100%;
    min-height: 100px;
    padding: 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--Darkerblue);
    color: var(--White);
    font-family: "AcuminBold", sans-serif;
  }
  .brand-container,
  .footer-links-container,
  .copyright-container,
  .contact-container {
    max-width: 25%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    font-family: "Acumin", sans-serif;
  }

  .copyright-container > p {
    color: var(--White);
  }

  .contact-container > p {
    color: white;
  }

  a {
    color: white;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .ul-footer {
    list-style: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  @media screen and (max-width: 1024px) {
    footer {
      padding: 3%;
    }
    .ul-footer > li > a,
    .contact-container > p,
    .copyright-container > p {
      font-size: 0.8rem;
      text-align: center;
    }

    .ul-footer {
      text-align: center;
    }
  }

  @media screen and (max-width: 768px) {
    footer {
      flex-direction: column;
      gap: 2rem;
      padding-block: 50px;
    }

    .ul-footer > li > a,
    .contact-container > p,
    .copyright-container > p {
      font-size: 1rem;
    }

    .ul-footer > li > a {
      text-decoration: underline;
    }

    .brand-container,
    .footer-links-container,
    .copyright-container,
    .contact-container {
      max-width: 100%;
    }

    .contact-container,
    .copyright-container {
      gap: 1rem;
    }
  }
</style>
